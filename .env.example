# =============================================================================
# Samjho — Environment Configuration (EXAMPLE / TEMPLATE ONLY)
# =============================================================================
# Copy this file to `.env` (never commit `.env`) and fill in real values.
# The real key is read ONLY on the server side (admin/ai/deepseek.js via
# admin/ai/deepseek/provider-enums.js). It is NEVER bundled to the browser.
#
#   admin/ai/provider.js     -> browser-safe status only (no secrets)
#   admin/ai/refine.js       -> browser-safe workflow (mock in browser)
#   admin/ai/server-bridge.js-> SERVER ONLY DeepSeek boundary
#   admin/ai/deepseek.js     -> SERVER ONLY provider implementation
# =============================================================================

# --- DeepSeek AI provider (MICRO 13/14, server side only) --------------------
# Required to enable real AI refinement. Leave blank to keep DeepSeek disabled
# (only the mock provider is used). NEVER commit a real value.
#
# For the Firebase Cloud Function (MICRO 14) set it SERVER-SIDE, one of:
#   firebase functions:config:set deepseek.api_key="<REAL KEY>"   (v1 config)
#   firebase functions:secrets:set DEEPSEEK_API_KEY               (v2 secrets)
#   DEEPSEEK_API_KEY environment variable on the runtime
DEEPSEEK_API_KEY=

# Optional. Defaults to "deepseek-chat" when unset. Kept configurable so the
# model can be changed without editing application code.
DEEPSEEK_MODEL=deepseek-flash

# Optional. DeepSeek API base URL (override only if DeepSeek changes it).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Comma-separated origins allowed to call the refine function
# cross-origin. Same-origin admin calls (via the Hosting rewrite) need nothing.
# ADMIN_ALLOWED_ORIGINS=https://samjhoindia.com
